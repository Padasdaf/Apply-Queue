# Browser automation (Browserbase project is inferred from this key)
BROWSERBASE_API_KEY=

# Field reasoning and generated answers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Browser-safe Supabase values (reserved for a future direct client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values used by the web server and worker
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Worker behavior
WORKER_POLL_INTERVAL_MS=2000
# Optional: print successful Stagehand readiness/snapshot diagnostics.
WORKER_BROWSER_DIAGNOSTICS=false
